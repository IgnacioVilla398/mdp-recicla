# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos ---
# Ruta al archivo SQLite (relativa a la raiz del proyecto o absoluta)
DB_FILE=db/mdp-recicla.sqlite

# --- Autenticacion (se usa a partir del Paso 2) ---
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=7d
SESSION_SECRET=cambiar-este-secreto-en-produccion

# --- Reglas de negocio ---
# Saldo minimo (en ARS) para habilitar la solicitud de cobro
MIN_PAYOUT_AMOUNT=2000
