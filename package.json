{
  "name": "mdp-recicla",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de recoleccion y monetizacion de residuos reciclables en Mar del Plata, Argentina.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test:api": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
